<view class="assessment-footer">
  <view class="assessment-footer__back">
    <primary-button
      text="{{backText}}"
      variant="quiet"
      disabled="{{backDisabled}}"
      bind:action="onBackAction"
    ></primary-button>
  </view>
  <view class="assessment-footer__next">
    <primary-button
      text="{{nextText}}"
      disabled="{{nextDisabled}}"
      bind:action="onNextAction"
    ></primary-button>
  </view>
</view>
