<view class="question-section">
  <view class="question-section__heading">
    <text class="question-section__title">{{title}}</text>
    <text wx:if="{{required}}" class="question-section__required">必填</text>
    <text wx:else class="question-section__optional">选填</text>
  </view>
  <text wx:if="{{hint}}" class="question-section__hint">{{hint}}</text>
  <slot></slot>
</view>
