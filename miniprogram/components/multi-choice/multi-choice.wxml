<view class="multi-choice {{warmSwiss ? 'is-warm-swiss' : ''}}">
  <view
    wx:for="{{renderedOptions}}"
    wx:key="value"
    class="multi-choice__item {{item.selected ? 'is-selected' : ''}} {{warmSwiss && fullWidthOptions[item.value] ? 'is-full-width' : ''}}"
    data-value="{{item.value}}"
    bindtap="onSelect"
  >
    <text class="multi-choice__label">{{item.label}}</text>
    <view class="multi-choice__mark" aria-hidden="true">
      <text wx:if="{{item.selected}}" class="multi-choice__check">✓</text>
    </view>
  </view>
</view>
