<button
  class="primary-button primary-button--{{variant}} {{warmSwiss ? 'is-warm-swiss' : ''}} {{browsing ? 'is-browsing' : ''}} {{block ? 'is-block' : ''}} {{disabled || loading ? 'is-disabled' : ''}}"
  loading="{{loading}}"
  disabled="{{disabled || loading}}"
  catch:tap="handleAction"
  hover-class="primary-button--active"
>
  <view wx:if="{{browsing}}" class="browse-button__content"><text>{{text}}</text></view>
  <block wx:else>{{text}}</block>
</button>
