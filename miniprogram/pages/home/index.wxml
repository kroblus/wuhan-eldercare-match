<navigation-bar title="武汉养老机构精准匹配" back="{{false}}" color="#27313D" background="#FFFFFF"></navigation-bar>

<page-container extraClass="home-page">
  <view class="home-hero">
    <tag text="武汉本地 · 精选机构池" tone="brand"></tag>
    <text class="home-hero__title">先了解老人情况，再找到更合适的养老机构</text>
    <text class="home-hero__description">从身体情况、照护需求、生活偏好和预算出发，逐步帮您梳理选择。</text>
    <primary-button text="开始养老需求评估" bind:action="startAssessment"></primary-button>
    <button class="home-secondary-button" bindtap="openInstitutions">先看看合作机构</button>
  </view>

    <section-card extraClass="home-section">
      <view class="section-heading">
        <view>
          <text class="section-heading__title">当前机构资料示例</text>
          <text class="section-heading__note">先浏览基础资料；详情入口仍处于开发验证阶段</text>
        </view>
        <tag text="开发 Mock" tone="development"></tag>
      </view>

      <view wx:if="{{showMockDisclosure}}" class="home-mock-disclosure">
        <text>{{mockDisclosure}}</text>
      </view>
      <state-panel wx:if="{{isLoading}}" state="loading" title="正在读取机构资料" message="仅加载当前本地开发目录"></state-panel>
      <state-panel wx:elif="{{loadError}}" state="error" title="机构资料暂时不可用" message="当前本地开发目录未能读取。" actionText="重新加载" bind:action="retryLoad"></state-panel>
      <state-panel wx:elif="{{empty}}" state="empty" title="当前暂无可展示的合作机构资料" message="资料补充后，这里会展示基础机构信息。"></state-panel>
      <block wx:else>
        <view
          wx:for="{{institutions}}"
          wx:key="key"
          class="institution-preview"
          data-item-key="{{item.key}}"
          data-institution-id="{{item.navigationIntent.institutionId}}"
          data-record-revision="{{item.navigationIntent.recordRevision}}"
          bindtap="openInstitution"
        >
          <view wx:if="{{item.hasCover}}" class="institution-preview__media institution-preview__media--image">
            <image src="{{item.coverUrl}}" mode="aspectFill" aria-label="{{item.name}}封面"></image>
          </view>
          <view wx:else class="institution-preview__media">
            <text>暂无机构图片</text>
          </view>
          <view class="institution-preview__body">
            <view class="institution-preview__title-row">
              <text class="institution-preview__title">{{item.name}}</text>
              <tag text="{{item.placementLabel}}" tone="development"></tag>
            </view>
            <text class="institution-preview__meta">区域：{{item.region}}（{{item.regionStatus}}）</text>
            <text class="institution-preview__meta">类型：{{item.type}}（{{item.typeStatus}}）</text>
            <text class="institution-preview__meta">参考费用：{{item.price}}（{{item.priceStatus}}）</text>
            <text class="institution-preview__meta">{{item.vrLabel}}</text>
          </view>
        </view>
      </block>
      <view wx:if="{{institutionActionError}}" class="home-action-error" role="alert">{{institutionActionError}}</view>
    </section-card>

  <section-card extraClass="home-section home-section--guide">
    <text class="guide-title">不知道该怎么选？</text>
    <text class="guide-description">完成几步简短评估，先了解老人更需要哪类照护，再看机构。</text>
    <primary-button text="3～5 分钟完成评估" variant="secondary" bind:action="startAssessment"></primary-button>
    <primary-button text="咨询养老顾问" variant="quiet" bind:action="openConsultant"></primary-button>
    <view wx:if="{{consultantActionError}}" class="home-action-error" role="alert">{{consultantActionError}}</view>
  </section-card>
</page-container>
