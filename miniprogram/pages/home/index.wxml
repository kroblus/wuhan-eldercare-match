<navigation-bar warmSwiss="{{true}}" title="武汉养老机构精准匹配" back="{{false}}"></navigation-bar>
<page-container extraClass="home-page">
  <view class="home-hero">
    <text class="home-brand-note">武汉本地养老机构匹配服务</text>
    <text class="home-hero__title">先了解老人情况，再找到更合适的养老机构。</text>
    <text class="home-hero__description">从身体情况、照护需求、生活偏好和预算出发，逐步帮您梳理选择。</text>
    <primary-button warmSwiss="{{true}}" text="开始养老需求评估 →" block="{{false}}" bind:action="startAssessment"></primary-button>
    <view aria-role="button" class="home-link" bindtap="openInstitutions">直接查看机构 →</view>
    <view wx:if="{{institutionListActionError}}" class="home-action-error" role="alert">{{institutionListActionError}}</view>
  </view>

  <view class="home-section">
    <view class="ws-section-heading"><text class="ws-section-number">01</text><text>{{showMockDisclosure ? '机构资料示例' : '机构资料预览'}}</text></view>
    <text class="section-heading__note">先浏览机构资料，目录顺序不代表推荐排名；完成评估后可查看匹配参考。</text>
    <view wx:if="{{showMockDisclosure}}" class="home-mock-disclosure"><tag text="开发 Mock" tone="development"></tag><text>{{mockDisclosure}}</text></view>
    <state-panel wx:if="{{isLoading}}" state="loading" title="正在读取机构资料" message="仅加载当前本地开发目录"></state-panel>
    <state-panel wx:elif="{{loadError}}" state="error" title="机构资料暂时不可用" message="当前本地开发目录未能读取。" actionText="重新加载" bind:action="retryLoad"></state-panel>
    <state-panel wx:elif="{{empty}}" state="empty" title="当前暂无可展示的合作机构资料" message="资料补充后，这里会展示基础机构信息。"></state-panel>
    <block wx:else>
      <view wx:for="{{institutions}}" wx:key="key" class="institution-preview" data-item-key="{{item.key}}" data-institution-id="{{item.navigationIntent.institutionId}}" data-record-revision="{{item.navigationIntent.recordRevision}}" bindtap="openInstitution" aria-role="button" aria-label="查看{{item.name}}资料">
        <view wx:if="{{item.hasCover}}" class="institution-preview__media"><image src="{{item.coverUrl}}" mode="aspectFill" aria-label="{{item.name}}封面"></image></view>
        <view wx:else class="institution-preview__media"><text>暂无机构图片</text></view>
        <view class="institution-preview__body">
          <text class="institution-preview__title">{{item.name}}</text>
          <tag text="{{item.placementLabel}}" tone="development"></tag>
          <text class="institution-preview__meta">区域：{{item.region}}（{{item.regionStatus}}）</text>
          <text class="institution-preview__meta">类型：{{item.type}}（{{item.typeStatus}}）</text>
          <text class="institution-preview__meta institution-preview__fee">参考费用：<text>{{item.price}}</text><text class="institution-preview__status">（{{item.priceStatus}}）</text></text>
          <text class="institution-preview__meta">{{item.vrLabel}}</text>
        </view>
        <text class="home-chevron" aria-hidden="true">›</text>
      </view>
    </block>
    <view aria-role="button" class="home-link home-all-institutions" bindtap="openInstitutions">查看全部机构 →</view>
    <view wx:if="{{institutionListActionError}}" class="home-action-error" role="alert">{{institutionListActionError}}</view>
    <view wx:if="{{institutionActionError}}" class="home-action-error" role="alert">{{institutionActionError}}</view>
  </view>

  <view class="home-section home-section--guide">
    <view class="ws-section-heading"><text class="ws-section-number">02</text><text>需要帮助？</text></view>
    <view aria-role="button" class="home-navigation-row" bindtap="openConsultant"><view><text class="home-navigation-row__title">养老顾问</text><text class="section-heading__note">人工协助解读评估结果与机构选择</text></view><text class="home-chevron">›</text></view>
    <view wx:if="{{consultantActionError}}" class="home-action-error" role="alert">{{consultantActionError}}</view>
    <view aria-role="button" class="home-navigation-row" bindtap="openAIConsultation"><view><text class="home-navigation-row__title">养老咨询助手</text><text class="section-heading__note">了解流程、常见问题与基础信息</text></view><text class="home-chevron">›</text></view>
    <view wx:if="{{aiActionError}}" class="home-action-error" role="alert">{{aiActionError}}</view>
  </view>
</page-container>
