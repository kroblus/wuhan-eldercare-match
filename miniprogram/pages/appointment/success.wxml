<navigation-bar title="预约申请结果" back="{{backEnabled}}" color="#27313D" background="#FFFFFF"></navigation-bar>
<page-container extraClass="route-page">
  <view class="page-shell">
    <view class="page-head">
      <text class="eyebrow">{{routeLabel}}</text>
      <text class="page-title">{{pageTitle}}</text>
      <text class="page-description">{{description}}</text>
    </view>
    <section-card>
      <tag text="状态以真实提交为准" tone="warning"></tag>
      <text class="route-card-title">预约申请结果占位</text>
      <text class="route-card-message">未来展示机构、日期、时间、人数和顾问确认状态；在没有真实提交结果前不得显示“预约成功”。</text>
      <state-panel state="development" title="等待真实预约结果" message="本页仅保留进入条件和展示结构，不代表已创建预约。"></state-panel>
    </section-card>
    <primary-button wx:if="{{showNext}}" text="{{nextLabel}}" bind:action="navigateNext"></primary-button>
  </view>
</page-container>
