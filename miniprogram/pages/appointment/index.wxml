<navigation-bar title="我的预约" back="true" color="#27313D" background="#FFFFFF"></navigation-bar>
<page-container extraClass="appointment-list-page">
  <view class="page-shell">
    <view class="page-head">
      <text class="eyebrow">预约记录</text>
      <text class="page-title">我的预约</text>
      <text class="page-description">预约状态以服务端或授权运营记录为准。</text>
    </view>

    <state-panel
      wx:if="{{loadState === 'loading'}}"
      state="loading"
      title="正在加载预约"
      message="请稍候。"
    ></state-panel>
    <state-panel
      wx:elif="{{loadState === 'load_error'}}"
      state="error"
      title="预约列表暂不可用"
      message="{{errorMessage}}"
    ></state-panel>
    <state-panel
      wx:elif="{{loadState === 'ready_empty'}}"
      state="empty"
      title="暂时没有预约记录"
      message="新的预约记录将在服务可用后显示。"
    ></state-panel>

    <block wx:elif="{{loadState === 'ready_non_empty'}}">
      <scroll-view class="appointment-filters" scroll-x="true" show-scrollbar="false">
        <view class="appointment-filters__row">
          <view
            wx:for="{{filters}}"
            wx:key="key"
            class="appointment-filter {{activeFilter === item.key ? 'appointment-filter--active' : ''}}"
            data-filter="{{item.key}}"
            bindtap="onFilterTap"
            aria-role="button"
            aria-label="{{item.label}}"
          >
            <text>{{item.label}}</text>
          </view>
        </view>
      </scroll-view>

      <state-panel
        wx:if="{{visibleVisits.length === 0}}"
        state="empty"
        title="这个状态下暂无预约"
        message="切换筛选查看其他预约记录。"
      ></state-panel>

      <block wx:else>
        <section-card wx:for="{{visibleVisits}}" wx:key="visitId" extraClass="appointment-card">
          <view class="appointment-card__heading">
            <text class="appointment-card__institution">{{item.institutionLabel}}</text>
            <tag text="{{item.statusLabel}}" tone="neutral"></tag>
          </view>
          <view class="appointment-card__detail">
            <text class="appointment-card__label">预约日期</text>
            <text class="appointment-card__value">{{item.visitDate}}</text>
          </view>
          <view class="appointment-card__detail">
            <text class="appointment-card__label">期望时间</text>
            <text class="appointment-card__value">{{item.visitTimePreference}}</text>
          </view>
          <view class="appointment-card__detail">
            <text class="appointment-card__label">同行人数</text>
            <text class="appointment-card__value">{{item.participantLabel}}</text>
          </view>
          <text wx:if="{{item.pickupLabel}}" class="appointment-card__pickup">{{item.pickupLabel}}</text>
          <primary-button
            wx:if="{{item.showEvaluationAction}}"
            text="填写看院评价"
            variant="secondary"
            data-visit-id="{{item.visitId}}"
            bind:action="openEvaluation"
          ></primary-button>
        </section-card>
      </block>
    </block>
  </view>
</page-container>
