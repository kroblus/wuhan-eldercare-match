<navigation-bar warmSwiss="{{true}}" title="养老咨询助手" back="{{true}}" color="#111827" background="#FBFAF7" fallbackUrl="/pages/home/index" fallbackIsTab="{{true}}" guardBack="{{true}}" navigationFailureMessage="返回失败，请重试"></navigation-bar>
<page-container extraClass="assistant-page">
  <view class="page-shell ai-chat-shell">
    <view class="page-head ai-chat-head">
      <text class="page-title">养老咨询助手</text>
      <text class="page-description">只解释已经批准的公开资料，不替代医疗、机构或顾问的正式判断。</text>
      <text class="ai-chat-provenance">当前使用已批准 FAQ，未接入在线模型；本页未读取本次老人画像、推荐或机构上下文。</text>
    </view>

    <view wx:if="{{viewModel}}" class="ai-chat-section ai-chat-status" role="status">
      <view class="ws-section-heading"><text class="ws-section-number">01</text><text>{{viewModel.stateTitle}}</text></view>
      <text class="ai-chat-state-message">{{viewModel.stateMessage}}</text>
      <text class="ai-chat-provenance">{{viewModel.provenanceLabel}}</text>
      <view wx:if="{{viewModel.errorMessage}}" class="ai-chat-error" role="alert">{{viewModel.errorMessage}}</view>
      <view wx:if="{{viewModel.showUnavailableNotice}}" class="ai-chat-unavailable" role="status">
        可回答已批准的常见问题；未匹配的问题会提示资料不足，复杂事项请联系养老顾问。当前未接入在线模型。
      </view>
    </view>

    <view class="ai-chat-section">
      <view class="ws-section-heading"><text class="ws-section-number">02</text><text>想先了解什么？</text></view>
      <text class="ai-chat-provenance">点选问题会填入输入框，确认后点击“发送问题”。</text>
      <view class="ai-chat-quick-list">
        <button wx:for="{{quickQuestions}}" wx:key="*this" class="ai-chat-quick-button" data-question="{{item}}" disabled="{{isSending}}" bindtap="onQuickQuestion">
          <text>{{item}}</text><text class="ai-chat-quick-arrow" aria-hidden="true">→</text>
        </button>
      </view>
    </view>

    <view wx:if="{{viewModel && viewModel.hasMessages}}" class="ai-chat-section ai-chat-conversation">
      <view class="ws-section-heading"><text class="ws-section-number">03</text><text>当前会话</text></view>
      <view wx:for="{{viewModel.messages}}" wx:key="messageId" id="{{item.messageId}}" class="ai-chat-message {{item.isUser ? 'ai-chat-message--user' : 'ai-chat-message--assistant'}} ai-chat-message--{{item.kind}}">
        <text class="ai-chat-message__role">{{item.roleLabel}}</text>
        <text class="ai-chat-message__content">{{item.content}}</text>
        <view wx:if="{{item.sourceLabels.length}}" class="ai-chat-source-list">
          <text wx:for="{{item.sourceLabels}}" wx:key="*this" class="ai-chat-source">依据：{{item}}</text>
        </view>
        <view wx:if="{{item.handoffExplanation}}" class="ai-chat-handoff-note"><text>{{item.handoffExplanation}}</text></view>
      </view>
    </view>

    <view class="ai-chat-section ai-chat-human">
      <view class="ws-section-heading"><text class="ws-section-number">{{viewModel && viewModel.hasMessages ? '04' : '03'}}</text><text>需要人工协助？</text></view>
      <text class="section-subtitle">顾问可以协助解释已有资料、确认需要人工跟进的事项，但不会替代医疗专业判断。</text>
      <view class="ai-chat-human__action">
        <primary-button warmSwiss="{{true}}" text="联系养老顾问" variant="quiet" disabled="{{isSending}}" bind:action="openHumanHandoff"></primary-button>
      </view>
      <view wx:if="{{actionError}}" class="ai-chat-error" role="alert">{{actionError}}</view>
    </view>
  </view>
</page-container>

<view class="ai-chat-composer">
  <view wx:if="{{inputError}}" class="ai-chat-error" role="alert">{{inputError}}</view>
  <view class="ai-chat-composer__row">
    <view class="ai-chat-input-wrap">
      <textarea class="ai-chat-input" value="{{inputValue}}" maxlength="500" auto-height placeholder="{{viewModel ? viewModel.inputPlaceholder : '请输入问题'}}" bindinput="onInput"></textarea>
    </view>
    <view class="ai-chat-send">
      <primary-button warmSwiss="{{true}}" text="{{isSending ? '正在发送…' : '发送问题'}}" loading="{{isSending}}" disabled="{{!viewModel || !viewModel.canSend}}" bind:action="onSend"></primary-button>
    </view>
  </view>
  <view wx:if="{{viewModel && viewModel.showRetry}}" class="ai-chat-retry">
    <primary-button warmSwiss="{{true}}" text="重新尝试" variant="secondary" disabled="{{isSending}}" bind:action="onRetry"></primary-button>
  </view>
</view>
