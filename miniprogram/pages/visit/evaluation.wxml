<navigation-bar title="看院评价" back="true" color="#27313D" background="#FFFFFF"></navigation-bar>
<page-container extraClass="route-page">
  <view class="page-shell evaluation-page">
    <view class="page-head">
      <text class="eyebrow">预约后续</text>
      <text class="page-title">看院评价</text>
      <text class="page-description">记录本次看院中的个人感受与观察。未选择的项目会保持空白。</text>
    </view>

    <state-panel
      wx:if="{{pageState === 'loading_context'}}"
      state="loading"
      title="正在确认预约"
      message="正在通过当前账号检查看院评价资格。"
    ></state-panel>
    <state-panel
      wx:elif="{{pageState === 'not_completed'}}"
      state="empty"
      title="暂不能填写看院评价"
      message="{{contextMessage}}"
    ></state-panel>
    <state-panel
      wx:elif="{{pageState === 'denied'}}"
      state="error"
      title="无法读取预约记录"
      message="{{contextMessage}}"
      actionText="重新检查"
      bind:action="onRetryContext"
    ></state-panel>
    <state-panel
      wx:elif="{{pageState === 'unavailable' || pageState === 'load_error'}}"
      state="error"
      title="评价上下文暂不可用"
      message="{{contextMessage}}"
      actionText="重新加载"
      bind:action="onRetryContext"
    ></state-panel>

    <block wx:else>
      <section-card extraClass="evaluation-context">
        <tag wx:if="{{contextMode === 'test_only'}}" text="开发测试上下文" tone="development"></tag>
        <tag wx:else text="已核验预约上下文" tone="brand"></tag>
        <text wx:if="{{contextMode === 'test_only'}}" class="evaluation-context__id">预约记录 {{visitId}}</text>
        <text class="evaluation-context__message">{{statusMessage}}</text>
        <text class="evaluation-context__message">{{contextMessage}}</text>
      </section-card>

      <section-card extraClass="evaluation-section">
        <view class="evaluation-section__heading">
          <text class="evaluation-section__title">总体印象</text>
          <text class="evaluation-section__hint">1–5 分</text>
        </view>
        <text class="evaluation-question">整体印象</text>
        <view class="rating-options">
          <view
            wx:for="{{overallOptions}}"
            wx:for-item="score"
            wx:key="value"
            class="rating-option {{score.selected ? 'rating-option--selected' : ''}} {{pageState !== 'editing' ? 'evaluation-control--disabled' : ''}}"
            data-question="overallRating"
            data-value="{{score.value}}"
            bindtap="onRatingTap"
            aria-role="button"
            aria-label="整体印象 {{score.value}} 分"
          >{{score.label}}</view>
        </view>

        <text class="evaluation-question evaluation-question--spaced">后续考虑</text>
        <view class="choice-list">
          <view
            wx:for="{{considerationOptions}}"
            wx:for-item="option"
            wx:key="key"
            class="choice-option {{option.selected ? 'choice-option--selected' : ''}} {{pageState !== 'editing' ? 'evaluation-control--disabled' : ''}}"
            data-value="{{option.key}}"
            bindtap="onConsiderationTap"
            aria-role="button"
          >{{option.label}}</view>
        </view>
      </section-card>

      <section-card wx:for="{{ratingSections}}" wx:for-item="section" wx:key="key" extraClass="evaluation-section">
        <view class="evaluation-section__heading">
          <text class="evaluation-section__title">{{section.title}}</text>
          <text class="evaluation-section__hint">1–5 分</text>
        </view>
        <view wx:for="{{section.items}}" wx:for-item="question" wx:key="key" class="rating-question">
          <text class="evaluation-question">{{question.label}}</text>
          <view class="rating-options">
            <view
              wx:for="{{question.options}}"
              wx:for-item="score"
              wx:key="value"
              class="rating-option {{score.selected ? 'rating-option--selected' : ''}} {{pageState !== 'editing' ? 'evaluation-control--disabled' : ''}}"
              data-question="{{question.key}}"
              data-value="{{score.value}}"
              bindtap="onRatingTap"
              aria-role="button"
              aria-label="{{question.label}} {{score.value}} 分"
            >{{score.label}}</view>
          </view>
        </view>
      </section-card>

      <section-card extraClass="evaluation-section">
        <view class="evaluation-section__heading">
          <text class="evaluation-section__title">费用透明</text>
          <text class="evaluation-section__hint">个人观察</text>
        </view>
        <text class="evaluation-question">收费介绍是否清楚</text>
        <view class="choice-list choice-list--compact">
          <view
            wx:for="{{feeClarityOptions}}"
            wx:for-item="option"
            wx:key="key"
            class="choice-option {{option.selected ? 'choice-option--selected' : ''}} {{pageState !== 'editing' ? 'evaluation-control--disabled' : ''}}"
            data-value="{{option.key}}"
            bindtap="onFeeClarityTap"
            aria-role="button"
          >{{option.label}}</view>
        </view>
        <text class="evaluation-subtitle">费用说明项目</text>
        <view class="topic-list">
          <text wx:for="{{feeTopics}}" wx:for-item="topic" wx:key="*this" class="topic-chip">{{topic}}</text>
        </view>
      </section-card>

      <section-card extraClass="evaluation-section">
        <view class="evaluation-section__heading">
          <text class="evaluation-section__title">护理管理观察</text>
          <text class="evaluation-section__hint">仅记录本次了解到的情况</text>
        </view>
        <text class="evaluation-question">是否了解到完整护理记录</text>
        <view class="choice-list choice-list--compact">
          <view
            wx:for="{{careRecordOptions}}"
            wx:for-item="option"
            wx:key="key"
            class="choice-option {{option.selected ? 'choice-option--selected' : ''}} {{pageState !== 'editing' ? 'evaluation-control--disabled' : ''}}"
            data-question="careRecordLearned"
            data-value="{{option.key}}"
            bindtap="onObservationTap"
            aria-role="button"
          >{{option.label}}</view>
        </view>

        <text class="evaluation-question evaluation-question--spaced">是否了解到 24 小时交接</text>
        <view class="choice-list choice-list--compact">
          <view
            wx:for="{{handoverLearnedOptions}}"
            wx:for-item="option"
            wx:key="key"
            class="choice-option {{option.selected ? 'choice-option--selected' : ''}} {{pageState !== 'editing' ? 'evaluation-control--disabled' : ''}}"
            data-question="handoverLearned"
            data-value="{{option.key}}"
            bindtap="onObservationTap"
            aria-role="button"
          >{{option.label}}</view>
        </view>

        <text class="evaluation-question evaluation-question--spaced">了解到交接包含</text>
        <view class="tag-list">
          <view
            wx:for="{{handoverTopics}}"
            wx:for-item="topic"
            wx:key="key"
            class="selection-tag {{topic.selected ? 'selection-tag--selected' : ''}} {{pageState !== 'editing' ? 'evaluation-control--disabled' : ''}}"
            data-value="{{topic.key}}"
            bindtap="onHandoverTopicTap"
            aria-role="button"
          >{{topic.label}}</view>
        </view>
        <text class="evaluation-note">“未确认”的互斥行为仅用于本页交互展示，尚未定义为提交数据规则。</text>
      </section-card>

      <section-card wx:for="{{tagGroups}}" wx:for-item="group" wx:key="key" extraClass="evaluation-section">
        <view class="evaluation-section__heading">
          <text class="evaluation-section__title">{{group.title}}</text>
          <text class="evaluation-section__hint">最多选择 3 项</text>
        </view>
        <view class="tag-list">
          <view
            wx:for="{{group.items}}"
            wx:for-item="tag"
            wx:key="key"
            class="selection-tag {{tag.selected ? 'selection-tag--selected' : ''}} {{pageState !== 'editing' ? 'evaluation-control--disabled' : ''}}"
            data-group="{{group.key}}"
            data-tag="{{tag.key}}"
            bindtap="onTagTap"
            aria-role="button"
          >{{tag.label}}</view>
        </view>
        <text wx:if="{{tagFeedbackGroup === group.key}}" class="evaluation-validation">{{tagFeedbackMessage}}</text>
      </section-card>

      <section-card extraClass="evaluation-section">
        <view class="evaluation-section__heading">
          <text class="evaluation-section__title">补充说明</text>
          <text class="evaluation-section__hint">选填 · 最多 200 字</text>
        </view>
        <textarea
          class="evaluation-comment"
          value="{{draft.comment}}"
          maxlength="200"
          auto-height="true"
          placeholder="记录其他看院感受（选填）"
          bindinput="onCommentInput"
          disabled="{{pageState !== 'editing'}}"
        ></textarea>
        <view class="evaluation-comment__count">已输入 {{commentLength}} 字 · 还可输入 {{commentRemaining}} 字</view>
      </section-card>

      <view wx:if="{{feedbackMessage}}" class="evaluation-feedback" aria-live="polite">{{feedbackMessage}}</view>
      <view wx:if="{{validationMessage}}" class="evaluation-validation" aria-live="assertive">{{validationMessage}}</view>
      <view wx:if="{{contextMode === 'test_only'}}" class="evaluation-submit">
        <primary-button
          text="{{submitButtonText}}"
          variant="primary"
          disabled="{{pageState === 'submitting' || pageState === 'submitted'}}"
          loading="{{pageState === 'submitting'}}"
          bind:action="onSubmit"
        ></primary-button>
        <text class="evaluation-submit__hint">提交只用于 TEST_ONLY 交互验证，不会保存真实评价。</text>
      </view>
      <view wx:else class="evaluation-submit">
        <text class="evaluation-submit__hint">填写内容仅暂存在当前页面；评价提交服务尚未接入，不会发送或保存。</text>
      </view>
    </block>
  </view>
</page-container>
