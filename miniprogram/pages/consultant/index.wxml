<navigation-bar title="养老顾问" back="{{backEnabled}}" color="#27313D" background="#FFFFFF"></navigation-bar>
<page-container extraClass="route-page">
  <view class="page-shell">
    <view class="page-head">
      <text class="eyebrow">{{routeLabel}}</text>
      <text class="page-title">{{pageTitle}}</text>
      <text class="page-description">{{description}}</text>
    </view>
    <section-card>
      <tag text="人工协助入口" tone="brand"></tag>
      <text class="route-card-title">有些选择，和专业顾问聊一聊更清楚</text>
      <text class="route-card-message">这里会承接画像解读、机构区别、费用说明、VR 和看院协调；不在 Bootstrap 阶段展示虚构人员资料。</text>
      <state-panel state="empty" title="顾问资料待接入" message="当前仅保留匿名友好的咨询入口结构，不主动要求登录或手机号。"></state-panel>
    </section-card>
    <button
      wx:if="{{showNext}}"
      class="consultant-next-button"
      bindtap="navigateToAppointment"
      hover-class="consultant-next-button--active"
    >
      {{nextLabel}}
    </button>
    <state-panel
      wx:if="{{navigationError}}"
      state="error"
      title="暂时无法打开预约页面"
      message="{{navigationErrorMessage}}"
      actionText="重试"
      bind:action="retryNavigate"
    ></state-panel>
  </view>
</page-container>
