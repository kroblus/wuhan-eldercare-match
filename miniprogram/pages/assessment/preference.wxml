<navigation-bar title="养老需求与偏好" back="{{backEnabled}}" fallbackUrl="/pages/assessment/cognitive" color="#27313D" background="#FFFFFF"></navigation-bar>
<page-container extraClass="assessment-page">
  <view class="page-shell">
    <progress-header current="5" total="6" label="评估 · 第 5 步"></progress-header>
    <view class="page-head assessment-head">
      <text class="page-title">说说家里最在意什么</text>
      <text class="page-description">没有标准答案，按家里真实的考虑选择即可。你的偏好会帮助我们解释推荐差异。</text>
    </view>

    <view wx:if="{{formError}}" class="form-error" role="alert">{{formError}}</view>

    <section-card extraClass="assessment-form-card">
      <view id="{{careTypeAnchorId}}" class="question-anchor">
        <question-section
          title="更希望选择哪类养老方式"
          hint="每项都有一句说明，选择最接近家里期待的方向"
          required="{{true}}"
          error="{{careTypeError}}"
        >
          <single-choice options="{{careTypeOptions}}" value="{{careType}}" bindchange="onCareTypeChange"></single-choice>
        </question-section>
      </view>

      <view id="{{prioritiesAnchorId}}" class="question-anchor">
        <question-section
          title="选择机构时最关注什么"
          hint="最多选择 3 项，可随时取消已经选中的内容"
          required="{{true}}"
          error="{{prioritiesError}}"
        >
          <multi-choice
            options="{{priorityOptions}}"
            values="{{priorities}}"
            max="{{priorityMax}}"
            bindchange="onPrioritiesChange"
            bindlimit="onPriorityLimit"
          ></multi-choice>
          <text wx:if="{{priorityLimitMessage}}" class="inline-hint inline-hint--warning" role="alert">{{priorityLimitMessage}}</text>
        </question-section>
      </view>

      <question-section
        title="希望所在区域"
        hint="只展示当前已核验合作机构实际存在的区域；不想限制时可选择“不限制”"
      >
        <single-choice
          wx:if="{{regionCatalogStatus === 'ready' || regionCatalogStatus === 'empty'}}"
          options="{{regionOptions}}"
          value="{{regionCode}}"
          bindchange="onRegionChange"
        ></single-choice>
        <text wx:if="{{regionStatusMessage}}" class="inline-hint">{{regionStatusMessage}}</text>
        <view wx:if="{{regionError}}" class="region-error" role="alert">
          <text class="region-error__message">{{regionError}}</text>
          <button class="region-error__retry" bindtap="onRetryRegionCatalog">重试</button>
        </view>
      </question-section>
    </section-card>

    <text class="save-status">{{saveStatus}}</text>
    <assessment-footer backText="上一步" bindback="onBack" bindnext="onNext"></assessment-footer>
  </view>
</page-container>
