<navigation-bar title="认知与特殊护理" back="{{backEnabled}}" color="#27313D" background="#FFFFFF"></navigation-bar>
<page-container extraClass="route-page">
  <view class="page-shell">
    <view class="page-head">
      <text class="eyebrow">{{routeLabel}}</text>
      <text class="page-title">{{pageTitle}}</text>
      <text class="page-description">{{description}}</text>
    </view>
    <section-card>
      <tag text="Bootstrap 骨架" tone="development"></tag>
      <text class="route-card-title">特殊照护入口已预留</text>
      <text class="route-card-message">允许在适合的题目选择“暂不确定”，后续硬性护理条件由真实机构能力数据决定。</text>
      <state-panel state="development" title="认知照护选项待后续实现" message="当前不作机构接收能力判断。"></state-panel>
    </section-card>
    <primary-button wx:if="{{showNext}}" text="{{nextLabel}}" bindtap="navigateNext"></primary-button>
  </view>
</page-container>
