<navigation-bar title="健康情况" back="{{backEnabled}}" color="#27313D" background="#FFFFFF"></navigation-bar>
<page-container extraClass="route-page">
  <view class="page-shell">
    <view class="page-head">
      <text class="eyebrow">{{routeLabel}}</text>
      <text class="page-title">{{pageTitle}}</text>
      <text class="page-description">{{description}}</text>
    </view>
    <section-card>
      <tag text="Bootstrap 骨架" tone="development"></tag>
      <text class="route-card-title">健康信息入口已预留</text>
      <text class="route-card-message">未来只采集推荐所需的最小信息，并明确说明健康与照护数据的使用范围。</text>
      <state-panel state="development" title="健康选项待后续实现" message="不在本批次生成疾病或风险答案。"></state-panel>
    </section-card>
    <primary-button wx:if="{{showNext}}" text="{{nextLabel}}" bindtap="navigateNext"></primary-button>
  </view>
</page-container>
