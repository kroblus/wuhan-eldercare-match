<navigation-bar title="评估说明" back="{{backEnabled}}" color="#27313D" background="#FFFFFF"></navigation-bar>
<page-container extraClass="route-page">
  <view class="page-shell">
    <view class="page-head">
      <text class="eyebrow">{{routeLabel}}</text>
      <text class="page-title">{{pageTitle}}</text>
      <text class="page-description">{{description}}</text>
    </view>
    <section-card>
      <tag text="Bootstrap 骨架" tone="development"></tag>
      <text class="route-card-title">先建立清楚的评估入口</text>
      <text class="route-card-message">后续会按基本情况、健康、自理能力、认知照护、偏好和预算逐步引导填写。</text>
      <state-panel state="development" title="问卷字段待后续实现" message="不在本批次暴露内部 ADL 评分或完整业务表单。"></state-panel>
    </section-card>
    <primary-button wx:if="{{showNext}}" text="{{nextLabel}}" bindtap="navigateNext"></primary-button>
  </view>
</page-container>
