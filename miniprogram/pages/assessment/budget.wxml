<navigation-bar title="预算与入住计划" back="{{backEnabled}}" color="#27313D" background="#FFFFFF"></navigation-bar>
<page-container extraClass="route-page">
  <view class="page-shell">
    <view class="page-head">
      <text class="eyebrow">{{routeLabel}}</text>
      <text class="page-title">{{pageTitle}}</text>
      <text class="page-description">{{description}}</text>
    </view>
    <section-card>
      <tag text="Bootstrap 骨架" tone="development"></tag>
      <text class="route-card-title">预算和时间只用于匹配参考</text>
      <text class="route-card-message">后续允许选择“暂不确定”，顾问联系方式只在用户明确发起联系或预约时按需获取。</text>
      <state-panel state="development" title="预算字段待后续实现" message="当前不显示任何机构价格或可入住承诺。"></state-panel>
    </section-card>
    <primary-button wx:if="{{showNext}}" text="{{nextLabel}}" bind:action="navigateNext"></primary-button>
  </view>
</page-container>
