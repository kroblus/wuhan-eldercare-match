<navigation-bar title="老人基本情况" back="{{backEnabled}}" fallbackUrl="/pages/assessment/intro" color="#27313D" background="#FFFFFF"></navigation-bar>
<page-container extraClass="assessment-page">
  <view class="page-shell">
    <progress-header current="1" total="6" label="评估 · 第 1 步"></progress-header>
    <view class="page-head assessment-head">
      <text class="page-title">先从老人现在的生活情况说起</text>
      <text class="page-description">不需要一次想全，已填内容会自动保存在本机，之后回来可以继续。</text>
    </view>

    <view wx:if="{{formError}}" class="form-error" role="alert">{{formError}}</view>

    <section-card extraClass="assessment-form-card">
      <view id="{{relationshipAnchorId}}" class="question-anchor">
        <question-section title="老人与您的关系" required="{{true}}" error="{{relationshipError}}">
          <single-choice options="{{relationshipOptions}}" value="{{relationship}}" bindchange="onRelationshipChange"></single-choice>
        </question-section>
      </view>

      <question-section title="老人姓名" hint="选填，仅用于家庭档案识别">
        <input class="text-input" value="{{elderName}}" maxlength="20" placeholder="例如：王奶奶" bindinput="onNameInput" />
      </question-section>

      <view id="{{genderAnchorId}}" class="question-anchor">
        <question-section title="性别" required="{{true}}" error="{{genderError}}">
          <single-choice options="{{genderOptions}}" value="{{gender}}" bindchange="onGenderChange"></single-choice>
        </question-section>
      </view>

      <view id="{{ageAnchorId}}" class="question-anchor">
        <question-section title="年龄" required="{{true}}" hint="请输入 50–110 岁的整数" error="{{ageError}}">
          <input class="text-input age-input" type="number" value="{{ageInput}}" maxlength="3" placeholder="例如：78" bindinput="onAgeInput" />
        </question-section>
      </view>

      <question-section title="目前居住状态" hint="选填，帮助顾问理解当前生活环境">
        <single-choice options="{{livingStatusOptions}}" value="{{livingStatus}}" bindchange="onLivingStatusChange"></single-choice>
      </question-section>

      <question-section title="主要照护者" hint="选填，可以先跳过">
        <single-choice options="{{caregiverOptions}}" value="{{primaryCaregiver}}" bindchange="onCaregiverChange"></single-choice>
      </question-section>

      <question-section title="是否有养老机构入住经历" hint="选填，帮助了解过去的照护体验">
        <single-choice options="{{experienceOptions}}" value="{{hasInstitutionExperience}}" bindchange="onExperienceChange"></single-choice>
      </question-section>

      <question-section wx:if="{{hasInstitutionExperience === 'true'}}" title="离开上一家机构的主要原因" hint="可多选，选择您认为重要的原因">
        <multi-choice options="{{exitReasonOptions}}" values="{{institutionExitReasons}}" bindchange="onExitReasonChange"></multi-choice>
      </question-section>
    </section-card>

    <text class="save-status">{{saveStatus}}</text>
    <assessment-footer backText="上一步" bindback="onBack" bindnext="onNext"></assessment-footer>
  </view>
</page-container>
