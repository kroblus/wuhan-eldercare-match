<navigation-bar title="日常生活能力" back="{{backEnabled}}" color="#27313D" background="#FFFFFF"></navigation-bar>
<page-container extraClass="route-page">
  <view class="page-shell">
    <view class="page-head">
      <text class="eyebrow">{{routeLabel}}</text>
      <text class="page-title">{{pageTitle}}</text>
      <text class="page-description">{{description}}</text>
    </view>
    <section-card>
      <tag text="Bootstrap 骨架" tone="development"></tag>
      <text class="route-card-title">用生活场景引导回答</text>
      <text class="route-card-message">后续会避免直接展示“失能等级”等内部术语，让家属只需描述老人日常情况。</text>
      <state-panel state="development" title="ADL 场景待后续实现" message="当前不展示内部评分、等级或推荐判断。"></state-panel>
    </section-card>
    <primary-button wx:if="{{showNext}}" text="{{nextLabel}}" bind:action="navigateNext"></primary-button>
  </view>
</page-container>
