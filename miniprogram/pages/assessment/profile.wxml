<navigation-bar title="老人需求画像" back="{{backEnabled}}" color="#27313D" background="#FFFFFF"></navigation-bar>
<page-container extraClass="route-page">
  <view class="page-shell">
    <view class="page-head">
      <text class="eyebrow">{{routeLabel}}</text>
      <text class="page-title">{{pageTitle}}</text>
      <text class="page-description">{{description}}</text>
    </view>
    <section-card>
      <tag text="Bootstrap 骨架" tone="development"></tag>
      <text class="route-card-title">把原始答案翻译成家属看得懂的话</text>
      <text class="route-card-message">未来按基本信息、健康、生活照护、特殊护理、偏好和预算分组展示，并允许返回对应题目修改。</text>
      <state-panel state="development" title="画像转换待后续实现" message="当前不生成任何画像结论或推荐分数。"></state-panel>
    </section-card>
    <primary-button wx:if="{{showNext}}" text="{{nextLabel}}" bind:action="navigateNext"></primary-button>
  </view>
</page-container>
