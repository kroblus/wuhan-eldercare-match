<navigation-bar title="老人档案详情" back="{{backEnabled}}" color="#27313D" background="#FFFFFF"></navigation-bar>
<page-container extraClass="route-page">
  <view class="page-shell">
    <view class="page-head">
      <text class="eyebrow">{{routeLabel}}</text>
      <text class="page-title">{{pageTitle}}</text>
      <text class="page-description">{{description}}</text>
    </view>
    <section-card>
      <tag text="档案详情骨架" tone="development"></tag>
      <text class="route-card-title">画像摘要和评估历史入口已预留</text>
      <text class="route-card-message">后续会展示基本情况、健康、自理、认知照护、偏好、预算和最近评估时间。</text>
      <state-panel state="empty" title="暂时没有可展示的老人档案" message="完成一次真实评估并保存后，这里才会显示档案详情。"></state-panel>
    </section-card>
    <primary-button wx:if="{{showNext}}" text="{{nextLabel}}" bindtap="navigateNext"></primary-button>
  </view>
</page-container>
