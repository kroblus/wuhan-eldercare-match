<navigation-bar title="VR 看院" back="{{backEnabled}}" color="#27313D" background="#FFFFFF"></navigation-bar>
<page-container extraClass="route-page">
  <view class="page-shell">
    <view class="page-head">
      <text class="eyebrow">{{routeLabel}}</text>
      <text class="page-title">{{pageTitle}}</text>
      <text class="page-description">{{description}}</text>
    </view>
    <section-card>
      <tag text="开发 Mock 结构" tone="development"></tag>
      <tag text="VR 内容模块" tone="brand"></tag>
      <text class="route-card-title">足不出户，先在线逛一遍</text>
      <state-panel state="empty" title="暂无真实 VR 内容" message="当前没有可访问的真实 VR 地址或场景，暂不展示虚构 Viewer。"></state-panel>
    </section-card>
    <primary-button wx:if="{{showNext}}" text="{{nextLabel}}" bindtap="navigateNext"></primary-button>
  </view>
</page-container>
