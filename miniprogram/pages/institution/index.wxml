<navigation-bar title="合作机构列表" back="{{backEnabled}}" color="#27313D" background="#FFFFFF"></navigation-bar>
<page-container extraClass="route-page">
  <view class="page-shell">
    <view class="page-head">
      <text class="eyebrow">{{routeLabel}}</text>
      <text class="page-title">{{pageTitle}}</text>
      <text class="page-description">{{description}}</text>
    </view>
    <section-card>
      <tag text="开发 Mock 结构" tone="development"></tag>
      <text class="route-card-title">精选机构列表壳层已建立</text>
      <text class="route-card-message">后续筛选和排序只能使用真实机构数据；当前 Mock 机构不代表任何合作方。</text>
      <state-panel state="development" title="机构资料待接入" message="地址、类型、费用、护理能力、图片和 VR 均显示为暂无数据或需咨询。"></state-panel>
    </section-card>
    <primary-button wx:if="{{showNext}}" text="{{nextLabel}}" bind:action="navigateNext"></primary-button>
  </view>
</page-container>
