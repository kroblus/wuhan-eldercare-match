<navigation-bar warmSwiss="{{true}}" title="机构详情" back="{{true}}" fallbackUrl="/pages/institution/index" bind:navigationfail="onNavigationFailure"></navigation-bar>
<template name="detailRows">
  <view wx:for="{{rows}}" wx:key="key" class="fact-row"><text class="fact-row__label">{{item.label}}</text><view class="fact-row__body"><text class="fact-row__value">{{item.value}}</text><text class="fact-row__status fact-row__status--{{item.statusTone}}">{{item.statusSummary}}</text></view></view>
</template>
<page-container extraClass="institution-detail-page">
  <view class="page-shell institution-detail-shell">
    <view wx:if="{{pageState === 'loading'}}"><state-panel state="loading" title="正在读取机构资料"></state-panel></view>
    <block wx:elif="{{pageState === 'ready' && viewModel && reading}}">
      <view class="institution-detail-head">
        <text wx:if="{{viewModel.hasDisclosure}}" class="detail-demo-note">演示资料，非真实机构信息。</text>
        <text class="page-title">{{reading.title}}</text><text wx:if="{{reading.region}}" class="detail-region">{{reading.region}}</text>
        <text wx:if="{{viewModel.historyLabel}}" class="history-label">{{viewModel.historyLabel}}</text><text wx:if="{{viewModel.revisionNotice}}" class="revision-notice">{{viewModel.revisionNotice}}</text>
        <view wx:if="{{viewModel.recommendation}}" class="detail-recommendation-overview"><text class="detail-subheading">本次推荐 · {{viewModel.recommendation.tierLabel}}</text><text wx:for="{{viewModel.recommendation.reasons}}" wx:key="key" class="detail-summary">{{item.value}}</text><view wx:if="{{viewModel.recommendation.differences.length}}" class="detail-important-note"><text class="detail-subheading">与本次需求有关的待确认事项</text><text wx:for="{{viewModel.recommendation.differences}}" wx:key="key" class="detail-summary">{{item.value}}</text></view></view>
        <view wx:if="{{actionErrorKey === 'back'}}" class="action-error" role="alert">{{actionErrorMessage}}</view>
      </view>
      <view wx:if="{{viewModel.media.hasCover && !coverLoadFailed}}" class="detail-cover-wrap"><image class="detail-cover" src="{{viewModel.media.coverUrl}}" mode="aspectFill" aria-label="{{viewModel.title}}封面" binderror="onCoverLoadError"></image></view>
      <view class="detail-contact-card">
        <text class="detail-subheading">机构位置</text><text class="detail-summary">{{viewModel.location.address}}</text>
        <text wx:if="{{viewModel.location.addressState !== 'ready'}}" class="detail-source-note">{{viewModel.location.addressStatus}}</text>
        <button wx:if="{{viewModel.location.mapAction.available}}" class="browse-button detail-map-button" data-action-key="map" bindtap="onMapTap">查看地图</button>
        <view wx:if="{{actionErrorKey === 'map'}}" class="action-error" role="alert">{{actionErrorMessage}}</view>
        <text class="detail-subheading detail-contact-title">机构官方电话</text>
        <view wx:if="{{viewModel.officialContact.hasPhones}}">
          <view wx:for="{{viewModel.officialContact.phones}}" wx:key="key" class="official-phone-row"><text class="detail-summary">{{item.purposeLabel}} · {{item.displayValue || item.statusLabel}}</text><text wx:if="{{item.displayValue && item.state !== 'verified'}}" class="detail-source-note">{{item.statusLabel}}</text><button wx:if="{{item.callAction.available}}" class="browse-button" data-phone-key="{{item.key}}" bindtap="onOfficialPhoneTap">{{item.callAction.label}}</button><text wx:else class="detail-source-note">{{item.callAction.label}}</text></view>
        </view><text wx:else class="detail-summary">{{viewModel.officialContact.statusLabel}}</text>
        <view wx:if="{{actionErrorKey === 'phone'}}" class="action-error" role="alert">{{actionErrorMessage}}</view>
      </view>
      <view wx:for="{{reading.groups}}" wx:key="key" wx:for-item="section" class="detail-section">
        <button class="detail-section-toggle" data-section-key="{{section.key}}" aria-label="{{section.title}}，{{expandedSections[section.key] ? '收起' : '展开'}}" aria-expanded="{{expandedSections[section.key] ? 'true' : 'false'}}" bindtap="onSectionToggle"><text class="detail-section-title">{{section.title}}</text><text class="detail-section-state">{{expandedSections[section.key] ? '收起' : '展开'}}</text></button>
        <text wx:if="{{!expandedSections[section.key]}}" class="detail-summary detail-summary--secondary">{{section.key === 'fees' ? '具体收费与接收条件，请向机构确认。' : section.key === 'care' ? '了解照护安排、人员及日常服务。' : '查看信息来源、核验日期与补充说明。'}}</text>
        <view wx:if="{{section.key === 'care' && viewModel.overview.careAlert}}" class="detail-important-note">{{viewModel.overview.careAlert}}</view>
        <view wx:if="{{expandedSections[section.key]}}" class="detail-section-content">
          <template is="detailRows" data="{{rows: section.rows}}" />
          <view wx:if="{{section.pendingLabels}}" class="detail-pending"><text class="detail-source-note">以下资料尚待补充，不代表机构没有相关服务：</text><text class="detail-summary detail-summary--secondary">{{section.pendingLabels}}</text></view>
          <block wx:if="{{section.key === 'fees'}}"><text class="detail-source-note">参考费用不是最终报价。请确认房型、照护等级、包含项目、押金及其他收费。</text><text class="detail-source-note">实际入住条件、材料与接收安排，以机构当期确认为准。</text></block>
          <block wx:if="{{section.key === 'care'}}"><text class="detail-source-note">护理管理与交接制度不代表特殊护理能力，请核实老人需要的具体服务。</text><view wx:for="{{reading.rooms}}" wx:key="key" class="detail-room"><text class="detail-subheading">{{item.name}} · {{item.type}}</text><template is="detailRows" data="{{rows: item.rows}}" /><text wx:if="{{item.pendingLabels}}" class="detail-source-note">待补充：{{item.pendingLabels}}</text></view></block>
          <block wx:if="{{section.key === 'info'}}">
            <view wx:if="{{viewModel.introduction}}"><text class="detail-subheading">机构简介</text><text class="detail-summary">{{viewModel.introduction.text}}</text><text class="detail-source-note">{{viewModel.introduction.sourceLabel}} {{viewModel.introduction.updatedDateLabel}}</text></view>
            <text class="detail-summary">{{viewModel.description}}</text><text class="detail-source-note">{{viewModel.contextLabel}}；核验仅适用于逐项标注的资料。</text>
            <text wx:if="{{viewModel.hasDisclosure}}" class="detail-demo-note">演示资料，非真实机构信息。所列服务与费用均为案例内容。</text>
            <text class="detail-source-note">{{viewModel.location.addressStatus}}；{{viewModel.location.mapStatus}}；{{viewModel.media.vrLabel}}。</text>
            <view wx:for="{{viewModel.officialContact.phones}}" wx:key="key"><text class="detail-source-note">{{item.purposeLabel}}：{{item.statusLabel}} {{item.verifiedDateLabel}}</text></view>
            <view wx:for="{{sourceNotes}}" wx:key="key" class="detail-source"><text class="detail-subheading">{{item.title}}</text><text class="detail-source-note">对应资料：{{item.fields}}</text><text class="detail-source-note">核对日期：{{item.verifiedOn}}；本次核验有效至：{{item.validUntil}}</text><text selectable="{{true}}" class="detail-source-url">{{item.url}}</text></view>
            <text wx:if="{{sourceNotes.length}}" class="detail-source-note">以上为公开页面核对，未实拨电话或现场确认；有效期为平台内部复核期限，不代表服务承诺。</text>
            <text wx:if="{{viewModel.historyLabel}}" class="detail-source-note">{{viewModel.disclosure}}</text>
            <view wx:if="{{viewModel.canViewCurrentRevision}}"><text class="detail-summary">本页保留原资料版本。</text><button class="browse-button" loading="{{isSwitchingRevision}}" disabled="{{isSwitchingRevision}}" bindtap="onViewCurrentRevision">{{viewModel.currentRevisionLabel}}</button></view>
          </block>
        </view>
        <view wx:if="{{section.key === 'care' && viewModel.media.canOpenVr}}" class="detail-media"><button class="browse-button" data-action-key="vr" bindtap="onVrTap">VR 看院</button><view wx:if="{{actionErrorKey === 'vr'}}" class="action-error" role="alert">{{actionErrorMessage}}</view></view>
      </view>
      <view wx:if="{{viewModel.media.gallery.length}}" class="gallery-list"><view wx:for="{{viewModel.media.gallery}}" wx:key="key" class="gallery-item"><image wx:if="{{item.url}}" class="gallery-item__image" src="{{item.url}}" mode="aspectFill" aria-label="机构图片"></image><text class="detail-source-note">{{item.caption}} {{item.status}}</text></view></view>
      <view class="detail-appointment-note"><text wx:if="{{canRequestService}}" class="detail-source-note">{{viewModel.hasDisclosure ? '仅体验模拟预约，不会联系机构。' : '提交申请后，请等待机构确认看院安排。'}}</text><text wx:else class="detail-source-note">仅供公开资料查询，不代表平台合作，暂未开放平台预约。</text></view>
      <view class="detail-sticky-actions"><primary-button browsing="{{true}}" warmSwiss="{{true}}" variant="quiet" text="咨询顾问" bind:action="onConsultantTap"></primary-button><primary-button wx:if="{{canRequestService}}" browsing="{{true}}" warmSwiss="{{true}}" text="{{viewModel.hasDisclosure ? '体验模拟预约' : '预约看院'}}" bind:action="onAppointmentTap"></primary-button></view>
      <view wx:if="{{actionErrorKey === 'consultant' || actionErrorKey === 'appointment'}}" class="action-error" role="alert">{{actionErrorMessage}}</view>
      <button class="browse-button browse-button--link detail-faq" data-action-key="faq" bindtap="onAIChatTap">看院常见问题</button><view wx:if="{{actionErrorKey === 'faq'}}" class="action-error" role="alert">{{actionErrorMessage}}</view>
    </block>
    <view wx:elif="{{errorViewModel}}"><state-panel state="error" title="{{errorViewModel.title}}" message="{{errorViewModel.message}}"></state-panel><view class="error-actions"><button wx:if="{{errorViewModel.canRetry}}" class="browse-button browse-button--primary" bindtap="onRetry">重新加载</button><button class="browse-button" bindtap="onBackToList">返回机构目录</button></view></view>
  </view>
</page-container>
