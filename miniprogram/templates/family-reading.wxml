<template name="family-reading">
  <navigation-bar warmSwiss="{{true}}" title="{{article.title}}" back="{{true}}" fallbackUrl="/pages/home/index" fallbackIsTab="{{true}}" bind:navigationfail="onNavigationFailure"></navigation-bar>
  <page-container extraClass="reading-page">
    <view class="reading-head"><text class="reading-kicker">{{article.kicker}}</text><text class="reading-title">{{article.title}}</text><text class="reading-intro">{{article.introduction}}</text></view>
    <view class="reading-metadata">
      <view wx:if="{{topic === 'policy'}}" class="reading-meta-row"><text>适用地域</text><text>全国 / 湖北 / 武汉，逐项区分</text></view>
      <view wx:if="{{topic === 'policy'}}" class="reading-meta-row"><text>全国通知发布</text><text>{{primarySource.published}}</text></view>
      <view class="reading-meta-row"><text>平台资料核对</text><text>{{reviewedOn}}（沿用核对记录）</text></view>
      <text class="reading-date">各来源的适用范围与原始发布日期见文末；资料核对日不等于发布日期。</text>
    </view>
    <view wx:if="{{expired}}" class="reading-notice" role="alert">2026年度消费补贴已超出本页所列适用期，请重新核对官方最新政策。本页保留历史说明。</view>
    <view class="reading-notice"><text class="reading-notice__title">{{topic === 'policy' ? '政策先看适用范围' : topic === 'education' ? '照护知识，不替代个人诊断' : '六步清单，逐项向机构核实'}}</text><text>{{article.notice}}</text></view>
    <button wx:if="{{topic === 'policy'}}" class="reading-original" disabled="{{copyPending}}" data-source-id="{{primarySource.id}}" bindtap="onCopySource">复制全国启动通知原文网址 ↗</button>
    <view class="{{topic === 'admission' ? 'reading-steps' : 'reading-chapters'}}">
      <view wx:for="{{sections}}" wx:key="title" class="reading-section {{topic === 'admission' ? 'reading-section--step' : ''}}">
        <view class="reading-chapter-head"><text class="reading-number">{{item.number}}</text><text class="reading-section__title">{{item.heading}}</text></view>
        <text wx:for="{{item.paragraphs}}" wx:key="*this" wx:for-item="paragraph" class="reading-paragraph">{{paragraph}}</text>
      </view>
    </view>
    <view class="reading-sources"><text class="reading-section__title">官方来源与核验范围</text><text class="reading-paragraph">以下为摘要与阅读提示，原文及后续更新请到官方渠道核对；核对日期不等于政策发布日期。</text>
      <view wx:for="{{article.sources}}" wx:key="id" class="reading-source"><text class="reading-source__title">{{item.title}}</text><text class="reading-date">适用范围：{{item.scope}}</text><text class="reading-date">原始发布：{{item.published}}</text><text selectable="{{true}}" class="reading-url">{{item.url}}</text><button class="reading-source__copy" disabled="{{copyPending}}" data-source-id="{{item.id}}" bindtap="onCopySource">复制官方来源网址</button></view>
    </view>
    <view wx:if="{{copyMessage}}" class="reading-message" role="status">{{copyMessage}}</view>
    <view class="reading-related"><text class="reading-section__title">接着了解</text><button wx:for="{{related}}" wx:key="topic" class="reading-source__copy" data-topic="{{item.topic}}" bindtap="openRelated">{{item.title}} →</button></view>
    <view wx:if="{{navigationError}}" class="reading-error" role="alert">{{navigationError}}</view>
    <button class="reading-home" bindtap="goHome">返回首页 →</button>
  </page-container>
</template>
