<template name="directory-controls">
  <view class="directory-search">
    <view class="directory-input-wrap">
      <text class="directory-search-mark" aria-hidden="true">⌕</text>
      <input aria-label="搜索养老机构名称" placeholder="搜索养老机构名称" value="{{keyword}}" focus="{{searchFocus}}" bindblur="onSearchBlur" bindinput="onSearchInput" confirm-type="search" adjust-position="{{true}}" cursor-spacing="32" />
      <button wx:if="{{keyword}}" class="directory-clear" bindtap="clearKeyword" aria-label="清除机构名称">清除</button>
    </view>
    <view wx:if="{{hasMetadataFilters}}" class="directory-filters">
      <picker range="{{districtOptions}}" range-key="label" value="{{districtIndex}}" bindchange="onDistrictChange" aria-label="选择武汉区域"><view class="directory-filter {{districtIndex ? 'is-selected' : ''}}"><text>{{districtOptions[districtIndex].label}}</text><text class="directory-arrow" aria-hidden="true">⌄</text></view></picker>
      <picker range="{{natureOptions}}" range-key="label" value="{{natureIndex}}" bindchange="onNatureChange" aria-label="选择机构性质"><view class="directory-filter {{natureIndex ? 'is-selected' : ''}}"><text>{{natureOptions[natureIndex].label}}</text><text class="directory-arrow" aria-hidden="true">⌄</text></view></picker>
    </view>
  </view>
</template>
<template name="directory-results">
  <view class="directory-heading"><view class="directory-heading__title"><text class="section-kicker">武汉养老机构</text><text class="directory-count">{{visibleItems.length}}家</text></view><button wx:if="{{keyword || natureIndex || districtIndex}}" class="browse-button browse-button--link directory-reset" bindtap="clearSearch">清除筛选</button></view>
  <view wx:if="{{!visibleItems.length}}" class="directory-search-empty"><text class="directory-empty-title">没有找到符合条件的机构</text><text>试试其他名称或筛选条件。</text><button class="browse-button" bindtap="clearSearch">清除筛选</button></view>
  <view wx:for="{{visibleItems}}" wx:key="key" class="institution-card" data-item-key="{{item.key}}" data-institution-id="{{item.navigationIntent.institutionId}}" data-record-revision="{{item.navigationIntent.recordRevision}}" data-route-source="{{item.navigationIntent.source}}" bindtap="onCardTap" role="button" aria-label="查看{{item.card.title}}详情">
    <text wx:if="{{item.showGroupHeading && item.recommendationGroup !== 'other'}}" class="institution-group-heading">{{item.groupLabel}}</text>
    <view class="institution-card__head"><text class="institution-name">{{item.card.title}}</text><text wx:if="{{item.card.isDemo}}" class="institution-demo-label">演示机构{{item.card.compact ? ' · TEST ONLY' : ''}}</text></view>
    <view class="institution-identity"><text class="institution-region">{{item.card.region}}{{item.card.nature ? ' · ' + item.card.nature : ''}}</text><view wx:if="{{item.card.factTags.length}}" class="institution-fact-tags"><text wx:for="{{item.card.factTags}}" wx:key="*this" wx:for-item="tag" class="institution-fact-tag">{{tag}}</text></view></view>
    <block wx:if="{{item.card.compact}}"><text wx:if="{{item.card.address}}" class="institution-address institution-address--direct">{{item.card.address}}</text><block wx:if="{{item.card.price}}"><text class="institution-price institution-price--direct">{{item.card.price}}</text><text class="institution-meta">随照护等级、房型等变化，非最终报价。</text></block></block>
    <view wx:elif="{{item.card.address || item.card.addressStatus || item.card.price}}" class="institution-info"><view wx:if="{{item.card.address || item.card.addressStatus}}"><text class="institution-meta">地址资料</text><text class="institution-address">{{item.card.address}}</text><text wx:if="{{item.card.addressStatus}}" class="institution-meta">{{item.card.addressStatus}}</text></view><view wx:if="{{item.card.price}}"><text class="institution-meta">收费信息</text><text class="institution-price">{{item.card.price}}</text></view></view>
    <text wx:for="{{item.card.notes}}" wx:key="*this" wx:for-item="note" class="institution-risk">{{note}}</text>
    <view wx:if="{{actionErrorKey === item.key}}" class="action-error" role="alert">{{actionErrorMessage}}</view>
    <view class="institution-card__footer"><view wx:if="{{item.card.compact}}" class="institution-card__actions"><view catchtap="onDirectoryPhoneTap" data-item-key="{{item.key}}"><button class="institution-phone" disabled="{{!item.card.isDemo && !item.card.phoneKey}}" aria-disabled="{{!item.card.isDemo && !item.card.phoneKey}}" aria-label="{{item.card.isDemo ? 'TEST ONLY 模拟拨号' : item.card.phoneKey ? '拨打' + item.card.title + '官方电话' : '官方电话不可用'}}"><view class="institution-phone-icon" aria-hidden="true" /></button></view><button catchtap="onCardTap" data-item-key="{{item.key}}" class="institution-detail-link">查看详情 ›</button></view><block wx:else><text wx:if="{{!item.card.compact && item.card.phone}}" class="institution-meta">{{item.card.phone}}</text><text class="institution-detail-link">查看详情 ›</text></block></view>
  </view>
</template>
