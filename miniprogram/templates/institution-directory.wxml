<template name="directory-controls">
        <view class="directory-search">
          <input aria-label="按机构名称搜索" placeholder="输入机构名称" value="{{keyword}}" bindinput="onSearchInput" confirm-type="search" />
          <view wx:if="{{hasMetadataFilters}}" class="directory-filters">
            <picker range="{{natureOptions}}" range-key="label" value="{{natureIndex}}" bindchange="onNatureChange"><view class="directory-filter">{{natureOptions[natureIndex].label}} ▾</view></picker>
            <picker range="{{districtOptions}}" range-key="label" value="{{districtIndex}}" bindchange="onDistrictChange"><view class="directory-filter">{{districtOptions[districtIndex].label}} ▾</view></picker>
          </view>
          <button wx:if="{{keyword || natureIndex || districtIndex}}" class="secondary-action" bindtap="clearSearch">清除搜索条件</button>
        </view>
</template>
<template name="directory-results">
        <view class="directory-heading">
          <text class="section-kicker">当前可展示资料</text>
          <text class="directory-count">共 {{visibleItems.length}} 条</text>
        </view>
        <text wx:if="{{!visibleItems.length}}" class="directory-search-empty">没有符合条件的机构，试试其他名称或筛选条件。</text>
        <view wx:for="{{visibleItems}}" wx:key="key" class="institution-card" data-item-key="{{item.key}}" data-institution-id="{{item.navigationIntent.institutionId}}" data-record-revision="{{item.navigationIntent.recordRevision}}" data-route-source="{{item.navigationIntent.source}}" bindtap="onCardTap" role="button" aria-label="查看{{item.name}}详情">
          <text wx:if="{{item.showGroupHeading}}" class="institution-group-heading">{{item.groupLabel}}</text>
          <view class="institution-row">
            <text class="institution-number">{{index > 8 ? '' : '0'}}{{index + 1}}</text>
            <view class="institution-cover-wrap">
              <image wx:if="{{item.hasCover}}" class="institution-cover" src="{{item.coverUrl}}" mode="aspectFill" aria-label="{{item.name}}封面"></image>
              <view wx:else class="institution-cover institution-cover--empty"><text>暂无机构图片</text></view>
            </view>
            <view class="institution-card__body">
              <text class="institution-name">{{item.name}}</text>
              <text class="fact-status {{item.nameStatus === '已核验' ? 'fact-status--verified' : ''}}">{{item.nameStatus}}</text>
              <view class="institution-meta">
                <text class="institution-meta__value">{{item.region}}</text>
                <text class="fact-status {{item.regionStatus === '已核验' ? 'fact-status--verified' : ''}}">{{item.regionStatus}}</text>
                <text class="institution-meta__value">{{item.type}}</text>
                <text class="fact-status {{item.typeStatus === '已核验' ? 'fact-status--verified' : ''}}">{{item.typeStatus}}</text>
              </view>
              <view class="institution-fee">
                <text class="institution-fee__label">参考月费</text>
                <text class="institution-fee__value">{{item.price}}</text>
                <text class="fact-status {{item.priceStatus === '已核验' ? 'fact-status--verified' : ''}}">{{item.priceStatus}}</text>
              </view>
              <view wx:if="{{item.tags.length}}" class="tag-list">
                <text wx:for="{{item.tags}}" wx:key="text" class="institution-tag">{{item.text}}</text>
              </view>
              <text class="institution-vr institution-vr--{{item.vrState}}">{{item.vrLabel}}</text>
              <text class="institution-placement">{{item.placementLabel}}</text>
              <text class="institution-card__footer">查看机构详情 →</text>
            </view>
          </view>
          <view wx:if="{{actionErrorKey === item.key}}" class="action-error" role="alert">{{actionErrorMessage}}</view>
        </view>
</template>
