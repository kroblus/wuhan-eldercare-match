<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.3</version>
        <relativePath/>
    </parent>

    <groupId>com.wuhan.eldercare</groupId>
    <artifactId>visit-submission-server</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>visit-submission-server</name>
    <description>V1.2-C4 authenticated visit submission backend foundation</description>

    <properties>
        <java.version>21</java.version>
        <flyway.version>10.20.1</flyway.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <version>${flyway.version}</version>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
            <version>${flyway.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>../admin-web</directory>
                <targetPath>static/p1-admin</targetPath>
                <includes><include>*.html</include><include>*.css</include><include>*.js</include></includes>
            </resource>
            <resource>
                <directory>../miniprogram/types</directory>
                <targetPath>assessment-validator/types</targetPath>
                <includes><include>assessment.ts</include><include>assessment-v2.ts</include></includes>
            </resource>
            <resource>
                <directory>tools</directory>
                <targetPath>assessment-validator/tools</targetPath>
                <includes><include>validate-completed-assessment.mjs</include></includes>
            </resource>
            <resource>
                <directory>../miniprogram</directory>
                <targetPath>assessment-validator/miniprogram</targetPath>
                <includes>
                    <include>domain/elder-profile/**/*.ts</include>
                    <include>domain/assessment-history/*.ts</include>
                    <include>domain/recommendation/**/*.ts</include>
                    <include>domain/institution/**/*.ts</include>
                    <include>presentation/**/*.ts</include>
                    <include>types/initial-reference-v1.ts</include>
                    <include>types/assessment*.ts</include>
                    <include>types/elder-profile*.ts</include>
                    <include>types/institution*.ts</include>
                    <include>types/recommendation*.ts</include>
                </includes>
            </resource>
            <resource>
                <directory>tools</directory>
                <targetPath>assessment-validator/tools</targetPath>
                <includes><include>derive-historical-profile.mjs</include><include>derive-historical-recommendation.mjs</include></includes>
            </resource>
            <resource>
                <directory>tools</directory>
                <targetPath>assessment-validator/tools</targetPath>
                <includes><include>derive-c2-snapshot.mjs</include></includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- The internal publisher executes these exact pure domain validators.
                 Keep the source closure in the server artifact; never package mocks. -->
            <resource>
                <directory>../miniprogram</directory>
                <targetPath>institution-validator/miniprogram</targetPath>
                <includes>
                    <include>domain/institution/**/*.ts</include>
                    <include>types/institution*.ts</include>
                </includes>
            </resource>
            <resource>
                <directory>tools</directory>
                <targetPath>institution-validator/tools</targetPath>
                <includes>
                    <include>validate-institution-record.mjs</include>
                </includes>
            </resource>
        </resources>
        <testResources>
            <testResource><directory>src/test/resources</directory></testResource>
            <testResource>
                <directory>../miniprogram/domain/appointment-institution-visit</directory>
                <includes>
                    <include>lifecycle.ts</include>
                </includes>
            </testResource>
        </testResources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
