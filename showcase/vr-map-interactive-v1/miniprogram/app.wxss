/* Snapshot of existing Warm Swiss tokens; local to this isolated package. */
page{background:#FBFAF7;color:#111827;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;font-size:30rpx;line-height:1.65}
view,text,button{box-sizing:border-box}button{margin:0;font:inherit;border-radius:12rpx;line-height:1.35}button::after{border:0}button[disabled]{color:#6B7280;background:#E9E7E2}
.shell{padding:36rpx 40rpx calc(48rpx + env(safe-area-inset-bottom))}.eyebrow{display:block;color:#6B7280;font-size:24rpx;letter-spacing:1rpx}.title{display:block;font-size:48rpx;line-height:1.25;font-weight:700;margin:14rpx 0 20rpx}.lead{display:block;color:#4B5563}.disclosure{border-left:4rpx solid #D9572A;background:#FAEEE8;padding:18rpx 22rpx;margin:28rpx 0;font-size:24rpx;color:#4B5563}.section{border-top:1rpx solid #D9D6D0;margin-top:40rpx;padding-top:26rpx}.section-title{display:block;font-size:34rpx;font-weight:700;line-height:1.35;margin-bottom:14rpx}.number{color:#D9572A;margin-right:18rpx;font-size:26rpx}.body{display:block;color:#4B5563}.meta{display:block;color:#6B7280;font-size:24rpx}.primary,.secondary{min-height:92rpx;padding:22rpx 20rpx}.primary{background:#D9572A;color:#fff;font-weight:600}.secondary{background:transparent;color:#111827;border:1rpx solid #D9D6D0}.actions{display:flex;gap:14rpx;margin-top:22rpx;flex-wrap:wrap}.actions button{flex:1;min-width:90rpx}.actions .wide{flex-basis:100%}.notice{margin-top:20rpx;color:#4B5563;font-size:26rpx}.error{color:#B5524D;border-left:4rpx solid #B5524D;padding:12rpx 18rpx;background:#FAEEE8}.stage{position:relative;width:100%;height:520rpx;border:1rpx solid #D9D6D0;border-radius:12rpx;overflow:hidden;background:#E9E4DE;margin-top:20rpx}.stage canvas{display:block;width:100%;height:100%}.watermark{position:absolute;left:12rpx;right:12rpx;top:12rpx;z-index:2;pointer-events:none;font-size:22rpx;line-height:1.4;color:#fff;background:rgba(17,24,39,.83);padding:10rpx 14rpx;border-radius:8rpx}.stage-overlay{position:absolute;left:18rpx;right:18rpx;top:40%;text-align:center;background:#FBFAF7;padding:18rpx;z-index:3}.hud{display:flex;justify-content:space-between;gap:12rpx;font-size:24rpx;color:#6B7280;margin:14rpx 0}.explanation{border-top:1rpx solid #D9D6D0;padding-top:22rpx;margin-top:24rpx}.back{margin-top:36rpx;width:100%}
