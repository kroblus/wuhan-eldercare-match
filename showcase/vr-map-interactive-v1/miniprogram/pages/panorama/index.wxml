<view class="shell">
  <text class="eyebrow">单场景 · 原创几何教学全景</text>
  <text class="title">环顾这个空间。</text>
  <text class="lead">拖动查看四周和上下。它只是交互示范，不代表任何养老机构的空间或设施。</text>
  <view class="stage" catchtouchstart="onTouchStart" catchtouchmove="onTouchMove" catchtouchend="onTouchEnd" catchtouchcancel="onTouchEnd">
    <canvas id="panorama" type="webgl" disable-scroll="{{true}}" binderror="onCanvasError"></canvas>
    <view class="watermark">合成教学空间 · 非机构实景 · 360° × 180°</view>
    <view wx:if="{{status !== 'ready'}}" class="stage-overlay" role="status">{{message}}</view>
  </view>
  <view class="hud"><text>水平 {{yaw}}° · 俯仰 {{pitch}}°</text><text>视野 {{fov}}°</text></view>
  <text wx:if="{{status === 'ready'}}" class="meta">{{message}}</text>
  <view class="actions">
    <button class="secondary" data-direction="out" bindtap="onZoom" disabled="{{status !== 'ready' || fov >= 100}}" aria-label="扩大视野">− 拉远</button>
    <button class="secondary" data-direction="in" bindtap="onZoom" disabled="{{status !== 'ready' || fov <= 45}}" aria-label="缩小视野">＋ 拉近</button>
    <button class="primary" bindtap="onReset" disabled="{{status !== 'ready'}}">复位</button>
  </view>
  <view wx:if="{{status !== 'ready' && status !== 'loading'}}" class="notice error" role="alert">{{message}}<button class="secondary" bindtap="onRetry">重新加载</button></view>
  <view class="explanation"><button class="secondary" bindtap="onInfo">{{showInfo ? '收起演示说明' : '查看演示说明'}}</button><text wx:if="{{showInfo}}" class="notice">由几何射线计算生成的完整球面素材，不是将平面照片拉伸。只演示环顾和视野调整，没有相机、定位、保存或预约功能。</text></view>
  <button class="secondary back" bindtap="onBack">返回演示首页</button>
  <view wx:if="{{navigationError}}" class="notice error" role="alert">{{navigationError}}</view>
</view>
