<view class="shell">
  <text class="eyebrow">本地示意图 · 没有地理精度</text>
  <text class="title">点选位置，看清状态。</text>
  <text class="lead">拖动、双指或按钮缩放。这里不是武汉街道地图，A / B 均不对应合作机构。</text>
  <view class="stage" catchtouchstart="onTouchStart" catchtouchmove="onTouchMove" catchtouchend="onTouchEnd" catchtouchcancel="onTouchCancel">
    <canvas id="schematic" type="2d" disable-scroll="{{true}}" binderror="onCanvasError"></canvas>
    <view class="watermark">示意地图 · 非真实机构位置 · 不可导航</view>
    <view wx:if="{{renderState !== 'ready'}}" class="stage-overlay" role="status">{{renderState === 'loading' ? '正在绘制本地示意图…' : '当前环境不支持示意图渲染，请返回。'}}</view>
  </view>
  <view class="hud"><text>拖动平移 · 点选标记</text><text>{{scale}}%</text></view>
  <view class="actions"><button class="secondary" data-direction="out" bindtap="onZoom" disabled="{{renderState !== 'ready' || scale <= 80}}">− 缩小</button><button class="secondary" data-direction="in" bindtap="onZoom" disabled="{{renderState !== 'ready' || scale >= 300}}">＋ 放大</button><button class="primary" bindtap="onReset" disabled="{{renderState !== 'ready'}}">居中</button></view>
  <view class="section"><text class="section-title"><text class="number">01</text>{{selectionTitle}}</text><text class="body">{{selectionMessage}}</text><view wx:if="{{state === 'schematic'}}" class="actions"><button class="secondary" data-id="demo-a" bindtap="onSelect" disabled="{{renderState !== 'ready'}}">选择 A</button><button class="secondary" data-id="demo-b" bindtap="onSelect" disabled="{{renderState !== 'ready'}}">选择 B</button></view></view>
  <view class="section"><text class="section-title"><text class="number">02</text>位置状态示范</text><text class="body">{{stateMessage}}</text><view class="actions"><button class="secondary" data-state="schematic" bindtap="onState">合成示意</button><button class="secondary" data-state="unknown" bindtap="onState">未知</button><button class="secondary" data-state="unverified" bindtap="onState">待核验</button><button class="secondary" data-state="expired" bindtap="onState">已过期</button><button class="secondary" data-state="unavailable" bindtap="onState">不可用</button></view></view>
  <view class="disclosure">未知、待核验、过期和不可用均不显示点位。即使合成示意点可见，也不能进入真实导航。</view>
  <button class="secondary back" bindtap="onBack">返回演示首页</button><view wx:if="{{navigationError}}" class="notice error" role="alert">{{navigationError}}</view>
</view>
