<navigation-bar warmSwiss="{{true}}" title="位置与周边" back="{{true}}" guardBack="{{true}}" fallbackUrl="{{story ? story.detailUrl : '/pages/showcase/index'}}"></navigation-bar>
<view class="story-shell" style="{{fontStyle}}"><text class="story-badge">演示区位 · 非真实院址</text><text class="story-title">{{story ? story.name : '武汉城市视野'}}</text><text>了解城区与道路，准备看院前的区位问题。</text><text class="story-muted">这里只展示武汉城区视野，不标记机构位置，不提供真实导航。演示区位不代表已经核验的院址。</text>
<block wx:if="{{allowed}}"><map wx:if="{{mapVisible}}" id="{{mapId}}" class="story-map" latitude="{{latitude}}" longitude="{{longitude}}" scale="{{scale}}" enable-scroll="{{true}}" enable-zoom="{{true}}" enable-rotate="{{false}}" show-location="{{false}}" bindupdated="mapUpdated" bindregionchange="regionChanged"></map><text class="story-muted">拖动地图或双指缩放，查看城市道路与区位。</text><text wx:if="{{loading}}" class="story-muted">正在载入城市地图…</text><view class="story-actions"><button id="reset-map" bindtap="resetMap">回到武汉地图</button><button id="retry-map" bindtap="retryMap">重新载入地图</button></view></block><text wx:if="{{error}}" class="story-error" role="alert">{{error}}</text></view>
