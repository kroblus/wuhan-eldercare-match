<view wx:if="{{compactHome}}" class="demo-home">
  <text class="demo-home__notice">演示数据 · 虚构机构</text>
  <button wx:if="{{!ready}}" class="browse-button" disabled="{{loading}}" loading="{{loading}}" bindtap="load">载入演示案例</button>
  <view wx:if="{{ready}}" class="demo-links"><button class="browse-button" data-target="profile" bindtap="open">查看需求画像</button><button class="browse-button" data-target="recommendation" bindtap="open">查看推荐机构</button></view>
  <text wx:if="{{error}}" class="error" role="alert">{{error}}</text>
</view>
<view wx:else class="demo-tools">
  <text class="demo-title">TEST ONLY · 演示工具</text><text>{{status}}</text>
  <text>以下案例与记录仅供体验，不会联系真实机构。</text>
  <view class="demo-load-actions"><button class="browse-button" disabled="{{loading || confirming}}" loading="{{loading}}" bindtap="load">重新载入案例</button><button class="browse-button" disabled="{{loading || confirming}}" bindtap="reset">重置演示记录</button></view>
  <view wx:if="{{ready && !serviceOnly}}" class="demo-links">
    <button class="browse-button" data-target="institutions" bindtap="open">浏览演示机构</button><button class="browse-button" data-target="profile" bindtap="open">查看需求评估</button><button class="browse-button" data-target="recommendation" bindtap="open">查看匹配结果</button><button class="browse-button" data-target="vr" bindtap="open">体验演示全景</button><button class="browse-button" data-target="map" bindtap="open">查看城区地图</button>
  </view>
  <view wx:if="{{ready && !serviceOnly}}" class="simulation"><text class="demo-title">保存新的演示评估</text><text>仅用于验证历史记录，不会覆盖旧评估。</text><picker range="{{elderNames}}" value="{{elderIndex}}" bindchange="selectElder"><view class="picker">关联老人：{{elderNames[elderIndex]}}</view></picker><button class="browse-button" disabled="{{saving || loading || confirming}}" loading="{{saving}}" bindtap="saveAssessment">另存当前已完成草稿</button></view>
  <view wx:if="{{ready}}" class="simulation">
    <text class="demo-title">预约与带看体验</text><text>仅模拟操作，不是真实预约或评价。</text>
    <text wx:if="{{institutionId}}">{{selectedName}}</text>
    <picker wx:else range="{{names}}" value="{{selectedIndex}}" bindchange="selectInstitution"><view class="picker">选择机构：{{selectedName}} ⌄</view></picker>
    <button wx:if="{{!serviceState}}" class="browse-button browse-button--primary" data-action="appointment" bindtap="simulate">模拟预约</button>
    <block wx:elif="{{serviceState === 'appointment_simulated'}}"><text>演示预约已创建，未联系机构。</text><button class="browse-button" data-action="visit" bindtap="simulate">模拟完成带看</button></block>
    <block wx:elif="{{serviceState === 'visit_simulated'}}"><text>演示带看已完成，可体验评价。</text><button class="browse-button" data-action="evaluation" bindtap="simulate">填写完整看院评价</button></block>
    <view wx:elif="{{serviceState === 'evaluation_simulated'}}"><text>TEST ONLY · 演示评价已保存，未提交到真实服务。</text><button class="browse-button" data-action="evaluation" bindtap="simulate">查看看院评价</button></view>
  </view>
  <text wx:if="{{error}}" class="error" role="alert">{{error}}</text>
</view>
